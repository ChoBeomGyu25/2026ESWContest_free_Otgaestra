    color: #EAF0F7;
    border: 1px solid #30445F;
    border-radius: 11px;
    font-size: 13px;
    font-weight: 800;
    padding: 7px 9px;
}
QPushButton#robotTestBackButton:hover,
QPushButton#robotUtilityButton:hover,
QPushButton#robotAuxButton:hover { background-color: #263A58; }

QPushButton#robotSelectButton {
    background-color: #152238;
    color: #BFD0E4;
    border: 2px solid #314867;
    border-radius: 13px;
    font-size: 13px;
    font-weight: 800;
}
QPushButton#robotSelectButton:checked {
    background-color: #285CB9;
    color: #FFFFFF;
    border-color: #77A9FF;
}
QPushButton#robotAutoTestButton {
    background-color: #315FBE;
    color: #FFFFFF;
    border: 1px solid #5C91F2;
    border-radius: 16px;
    font-size: 15px;
    font-weight: 900;
    padding: 10px;
}
QPushButton#robotAutoTestButton:hover { background-color: #3D73D9; }
QPushButton#robotAutoTestButton:pressed { background-color: #284F9F; }
QPushButton#robotJogButton {
    background-color: #1B2A40;
    color: #EAF0F7;
    border: 1px solid #3A5273;
    border-radius: 11px;
    font-size: 13px;
    font-weight: 800;
}
QPushButton#robotJogButton:hover { background-color: #2A4262; }
QPushButton#robotJogButton:pressed { background-color: #345475; }
QLabel#robotManualTitle,
QLabel#robotControlLabel {
    color: #DCE7F5;
    font-size: 13px;
    font-weight: 800;
}
QComboBox#robotStepCombo {
    background-color: #0E1929;
    color: #EAF0F7;
    border: 1px solid #30445F;
    border-radius: 9px;
    min-height: 34px;
    padding: 4px 8px;
    font-size: 13px;
    font-weight: 700;
}
QPlainTextEdit#robotTestLog {
    background-color: #07101C;
    color: #C8D6E8;
    border: 1px solid #273956;
    border-radius: 12px;
    font-family: "DejaVu Sans Mono", "Noto Sans Mono CJK KR", monospace;
    font-size: 11px;
    padding: 8px;
}
QLabel#robotTestWarning {
    background-color: #302919;
    color: #FFD47A;
    border: 1px solid #5A4721;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 10px;
}
