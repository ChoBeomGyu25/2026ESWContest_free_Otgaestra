QLabel#robotTestMainStatus {
    background-color: #152238;
    color: #E5EDF8;
    border: 1px solid #2B4160;
    border-radius: 13px;
    font-size: 14px;
    font-weight: 800;
    padding: 9px 11px;
}
QPushButton#robotTestBackButton,
QPushButton#robotUtilityButton,
QPushButton#robotAuxButton {
